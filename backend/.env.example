# Copy to .env. Use different data, keys and hostnames for sandbox/production.
MIUCAM_STORE_ENVIRONMENT=production
MIUCAM_LICENSE_PRIVATE_KEY_FILE=/secrets/license-signing.pem
MIUCAM_LICENSE_DATABASE=/data/licenses.sqlite3
# If an HTTPS reverse proxy is used, set only its actual trusted IP(s):
# FORWARDED_ALLOW_IPS=YOUR_PROXY_IP

MIUCAM_GOOGLE_PLAY_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-play.json
# Authenticated Pub/Sub push subscription for Google RTDN:
MIUCAM_GOOGLE_NOTIFICATION_AUDIENCE=https://billing.example.com/notifications/google
MIUCAM_GOOGLE_NOTIFICATION_EMAIL=play-notifications@YOUR_PROJECT.iam.gserviceaccount.com

# Enable after replacing every Apple placeholder with the actual app values.
MIUCAM_APP_STORE_ENABLED=false
MIUCAM_APPLE_SIGNING_KEY_FILE=/secrets/AuthKey.p8
MIUCAM_APPLE_KEY_ID=YOUR_KEY_ID
MIUCAM_APPLE_ISSUER_ID=YOUR_ISSUER_ID
MIUCAM_APPLE_ROOT_CERTIFICATES=/secrets/AppleRootCA-G3.cer
MIUCAM_APPLE_APP_ID=YOUR_NUMERIC_APP_ID
